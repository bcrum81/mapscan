# ---------------------------------------------------------------------------
# mapscan  —  copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- database (PostgreSQL 15+) ---
DATABASE_URL=postgresql://mapscan:CHANGEME@localhost:5432/mapscan

# --- redis (arq job queue) ---
REDIS_URL=redis://localhost:6379/0

# --- brand ---
# Whose products are protected. Shown in the UI and on the public /about page.
BRAND_NAME="Your Brand"
# Shown on /about so site owners can ask to be excluded.
CONTACT_EMAIL=
# Your own storefront domain(s), comma-separated; never flagged as a seller.
OWN_DOMAINS=yourbrand.com
# Slug tokens that mark a URL as yours (comma-separated). Defaults to the
# first word of BRAND_NAME. Can also be set from the Settings page.
BRAND_TOKENS=

# --- service ---
BIND_HOST=127.0.0.1
BIND_PORT=8013
EVIDENCE_DIR=./evidence
LOG_LEVEL=INFO

# --- discovery: Brave Search ---
# The web-search provider. Google's Custom Search JSON API is deliberately not
# used: it is closed to new customers and is discontinued 2027-01-01.
# Without this key, web discovery is disabled -- sitemap scans still work.
BRAVE_SEARCH_KEY=
# Monthly query cap, enforced in the search_budget table before every query.
# Confirm your plan's actual limit and set this to match; the free tier has
# historically been ~2000/mo. Set it BELOW your real cap to leave headroom.
BRAVE_MONTHLY_BUDGET=2000
# Queries per sweep run. 300 SKUs x 2 queries = 600 for one full catalog pass,
# so at 2000/mo keep this modest and let the round-robin cursor spread coverage
# across runs. Raise it if you move to a paid tier.
DISCOVERY_QUERIES_PER_RUN=150

# --- fetching ---
# Tier 1 is direct httpx and costs nothing. Tier 2 is only used for domains
# that demonstrably block us, and for evidence screenshots.
USER_AGENT="MAPScan/1.0 (+https://mapscan.example.com/about)"
PER_DOMAIN_DELAY_SECONDS=3.0
MAX_CONCURRENT_FETCHES=8
FETCH_TIMEOUT_SECONDS=30
RESPECT_ROBOTS=true

# --- tier 2 fetch vendor (leave blank to run tier-1-only) ---
# Supported: "" (disabled) | "scrapingbee" | "zyte"
FETCH_VENDOR=
SCRAPINGBEE_KEY=
ZYTE_KEY=

# --- LLM extraction fallback (OpenAI) ---
# Only invoked when platform JSON, JSON-LD, microdata and selector rules ALL
# fail on a page. Enter the key through the admin Settings page instead of
# here -- it is stored encrypted in the database and these env vars are only a
# fallback. The model must support strict json_schema responses.
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-4o-mini
LLM_EXTRACTION_ENABLED=true
# Page text is trimmed to the regions around a price first; this cap is the
# main cost control on the tier.
LLM_MAX_INPUT_CHARS=24000

# --- matching thresholds (0-100) ---
MATCH_AUTO_CONFIRM=85
MATCH_AUTO_REJECT=45

# --- violations ---
# Require N consecutive sub-MAP observations before opening a violation, so a
# dealer bouncing a dollar under for one crawl does not create noise.
VIOLATION_CONSECUTIVE_CHECKS=2
VIOLATION_MIN_DELTA_PCT=0.5

# ---------------------------------------------------------------------------
# authentication
# ---------------------------------------------------------------------------
# Signs the session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this logs every user out.
SECRET_KEY=
PUBLIC_BASE_URL=https://mapscan.example.com
SESSION_MAX_AGE_SECONDS=43200
COOKIE_SECURE=true

# --- invite / reset email delivery ---
# manual = do not send; show the invite link in the UI for the admin to pass on.
# This is the default so user creation works with no mail provider configured.
# Set to "smtp" or "resend" to have the app send the link itself.
EMAIL_PROVIDER=manual
EMAIL_FROM=

# resend
RESEND_KEY=

# smtp (port 465 implies implicit TLS; anything else uses STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# settings encryption
# ---------------------------------------------------------------------------
# Encrypts credentials entered through the admin Settings page, so an API key
# never has to be written into this file or the repository. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ROTATING THIS ORPHANS EVERY STORED SECRET -- they must be re-entered.
# It is deliberately separate from SECRET_KEY, so you can rotate session
# signing (logging everyone out) without losing your stored credentials.
SETTINGS_KEY=
