#!/bin/sh
# Mint a one-time password-reset link.
# Install on the server's PATH; run as:   mapscan-reset admin@example.com
# APP_DIR defaults to /opt/mapscan.
set -e
APP_DIR="${APP_DIR:-/opt/mapscan}"
cd "$APP_DIR"
set -a
. "$APP_DIR/.env"
set +a
exec "$APP_DIR/venv/bin/python" "$APP_DIR/tools/reset_password.py" "$@"
